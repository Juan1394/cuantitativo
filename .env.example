# Competiciones activas; acepta un array JSON con cualquier subconjunto de ["SP1","E0","I1"] sin duplicados.
ACTIVE_COMPETITIONS=["SP1","E0","I1"]
# Modo de simulación; acepta true o false y cambia las rutas de base de datos.
DRY_RUN=False
# Umbral mínimo de EV; acepta decimal mayor que 0.
EV_THRESHOLD=0.02
# Fracción de Kelly; acepta decimal mayor que 0 y menor o igual que 1.
KELLY_FRACTION=0.25
# Porcentaje máximo de bankroll por apuesta; acepta decimal mayor que 0 y menor o igual que 0.05.
MAX_BANKROLL_PCT_PER_BET=0.03
# Método de de-vigging; acepta multiplicative o shin.
DEVIG_METHOD=multiplicative
# Edge máximo admitido por la comprobación de sanidad; acepta decimal.
SANITY_CHECK_MAX_EDGE=0.25
# Desviación máxima de la cuota manual; acepta decimal mayor que 0.
MANUAL_ODDS_DEVIATION_PCT=0.15
# Antigüedad máxima de la cuota manual en minutos; acepta entero.
MANUAL_ODDS_STALENESS_MIN=5
# Mínimo de apuestas para el informe técnico; acepta entero menor que INTERPRETABLE_MIN_BETS.
TECHNICAL_MIN_BETS=20
# Mínimo de apuestas para el informe interpretable; acepta entero mayor que TECHNICAL_MIN_BETS.
INTERPRETABLE_MIN_BETS=50
# Mínimo de apuestas por decil para calibración; acepta entero.
CALIBRATION_MIN_PER_DECILE=10
# Intervalo de captura en horas para partidos con kickoff en menos de 6 horas; acepta entero.
SNAPSHOT_INTERVAL_NEAR_H=1
# Intervalo de captura en horas para el resto de partidos; acepta entero.
SNAPSHOT_INTERVAL_FAR_H=2
# Ventana en horas que define partido cercano; acepta entero.
SNAPSHOT_NEAR_WINDOW_H=6
# Porcentaje diario máximo de capturas; acepta decimal.
SNAPSHOT_DAILY_CAP_PCT=0.70
# Mínimo de capturas válidas por evento; acepta entero.
SNAPSHOT_MIN_VALID_PER_EVENT=3
# Si true, execute() puede llamar a The Odds API. Por defecto false para no consumir cuota durante el desarrollo.
SNAPSHOT_EXECUTION_ENABLED=false
# Margen de gracia para cierres en minutos; acepta entero.
CLOSURE_GRACE_PERIOD_MIN=120
# Intervalo del planificador en minutos; acepta entero.
SCHEDULER_INTERVAL_MIN=10
# Partidos entre reentrenamientos; acepta entero.
RETRAIN_EVERY_N_MATCHES=10
# Zona horaria de la interfaz; acepta nombre de zona IANA como Europe/Madrid.
TIMEZONE=Europe/Madrid
# Clave de API-Football; acepta texto no vacío en .env, vacío aquí y falla el arranque si falta.
API_FOOTBALL_KEY=
# Clave de football-data.org; acepta texto no vacío en .env, vacío aquí y falla el arranque si falta.
FOOTBALL_DATA_ORG_KEY=
# Proveedor sharp principal; acepta pinnodds o the_odds_api.
SHARP_ODDS_PROVIDER=pinnodds
# Clave del proveedor sharp principal; acepta texto no vacío en .env, vacío aquí y falla el arranque si falta.
SHARP_ODDS_API_KEY=
# Proveedor sharp de respaldo; acepta pinnodds, the_odds_api o vacío para no usar respaldo.
SHARP_ODDS_FALLBACK_PROVIDER=
# Clave del proveedor de respaldo; acepta texto no vacío cuando hay proveedor, vacío aquí y ausente por defecto.
SHARP_ODDS_FALLBACK_API_KEY=
# Token del bot de Telegram; acepta texto o vacío para no usar notificaciones.
TELEGRAM_BOT_TOKEN=
# Identificador de chat de Telegram; acepta texto o vacío para no usar notificaciones.
TELEGRAM_CHAT_ID=
# Directorio de copias de seguridad; acepta ruta relativa o absoluta.
BACKUP_DIR=backups
# Nivel de registro; acepta DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
# Directorio de registros; acepta ruta relativa o absoluta.
LOG_DIR=logs
# Directorio de modelos .pkl; acepta ruta relativa o absoluta.
MODELS_DIR=models
# El fichero real de configuración es .env y no debe subirse a git.
